#!/usr/bin/env bash
set -euo pipefail

domain="gui/$(id -u)"
for agent_label in com.localwebmonitorex.updater com.localwebmonitorex; do
  launchctl bootout "$domain/$agent_label" >/dev/null 2>&1 || true
  rm -f "$HOME/Library/LaunchAgents/$agent_label.plist"
done
echo "LocalWebMonitorex and its updater were removed from login startup."
echo "Your port preference and installed copies under ~/Library/Application Support were kept."
